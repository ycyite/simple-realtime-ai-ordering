# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Phone Call Integration (Optional - only needed if using Twilio)
# For Railway deployment: Set BOTH to your Railway domain
# Get your domain with: railway domain
# Example: your-app.railway.app
SIP_PORT=5060
SIP_DOMAIN=your-app.railway.app
PUBLIC_IP=your-app.railway.app

# Note: SIP_DOMAIN and PUBLIC_IP should be the SAME value (your Railway domain)

# Twilio Configuration (Optional - for reference only)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
