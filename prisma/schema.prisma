generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model call_logs {
  id                          String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                   String?               @db.Uuid
  order_id                    String?               @db.Uuid
  call_sid                    String?               @db.VarChar(100)
  from_number                 String?               @db.VarChar(20)
  duration                    Int?
  cached_text_input_tokens    Int?                  @default(0)
  uncached_text_input_tokens  Int?                  @default(0)
  cached_audio_input_tokens   Int?                  @default(0)
  uncached_audio_input_tokens Int?                  @default(0)
  text_output_tokens          Int?                  @default(0)
  audio_output_tokens         Int?                  @default(0)
  total_tokens                Int?                  @default(0)
  cost                        Decimal?              @db.Decimal(10, 4)
  recording_url               String?
  transcript                  String?
  created_at                  DateTime?             @default(now()) @db.Timestamp(6)
  orders                      orders?               @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                     tenants?              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallet_transactions         wallet_transactions[]

  @@index([tenant_id], map: "idx_call_logs_tenant_id")
}

model menu_items {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id   String?   @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  price       Decimal   @db.Decimal(10, 2)
  category    String?   @db.VarChar(100)
  available   Boolean?  @default(true)
  image_url   String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  tenants     tenants?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_menu_items_tenant_id")
}

model orders {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id      String?     @db.Uuid
  order_number   String?     @db.VarChar(50)
  customer_name  String?     @db.VarChar(255)
  customer_phone String?     @db.VarChar(20)
  items          Json
  total_amount   Decimal     @db.Decimal(10, 2)
  status         String?     @default("undealt") @db.VarChar(50)
  source         String?     @default("phone") @db.VarChar(50)
  pickup_time    String?     @db.VarChar(50)
  notes          String?
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  updated_at     DateTime?   @default(now()) @db.Timestamp(6)
  call_logs      call_logs[]
  tenants        tenants?    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_orders_created_at")
  @@index([status], map: "idx_orders_status")
  @@index([tenant_id], map: "idx_orders_tenant_id")
}

model tenants {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String                @db.VarChar(255)
  slug                  String                @unique @db.VarChar(100)
  phone_number          String?               @db.VarChar(20)
  address               String?
  postal_code           String?               @db.VarChar(20)
  timezone              String?               @db.VarChar(50)
  wallet_balance        Decimal?              @default(0.00) @db.Decimal(10, 2)
  stripe_customer_id    String?               @db.VarChar(100)
  twilio_phone_number   String?               @unique @db.VarChar(20)
  status                String?               @default("active") @db.VarChar(50)
  is_open               Boolean?              @default(true)
  created_at            DateTime?             @default(now()) @db.Timestamp(6)
  updated_at            DateTime?             @default(now()) @db.Timestamp(6)
  settings              Json?
  subscription_fee      Decimal?              @default(10.00) @db.Decimal(10, 2)
  low_balance_threshold Decimal?              @default(10.00) @db.Decimal(10, 2)
  subscription_status   String?               @default("active") @db.VarChar(50)
  call_logs             call_logs[]
  invite_codes          invite_codes[]
  menu_items            menu_items[]
  orders                orders[]
  user_tenants          user_tenants[]
  users_last_active     users[]               @relation("LastActiveTenant")
  wallet_transactions   wallet_transactions[]
}

model users {
  id                    String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clerk_user_id         String         @unique @db.VarChar(255)
  email                 String         @db.VarChar(255)
  name                  String         @db.VarChar(255)
  created_at            DateTime?      @default(now()) @db.Timestamp(6)
  last_login            DateTime?      @db.Timestamp(6)
  last_active_tenant_id String?        @db.Uuid
  created_invites       invite_codes[] @relation("CreatedInvites")
  used_invites          invite_codes[] @relation("UsedInvites")
  user_tenants          user_tenants[]
  last_active_tenant    tenants?       @relation("LastActiveTenant", fields: [last_active_tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([clerk_user_id], map: "idx_users_clerk_id")
}

model wallet_transactions {
  id                       String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                String?    @db.Uuid
  type                     String     @db.VarChar(50)
  amount                   Decimal    @db.Decimal(10, 2)
  balance_after            Decimal    @db.Decimal(10, 2)
  description              String?
  stripe_payment_intent_id String?    @db.VarChar(100)
  metadata                 Json?
  created_at               DateTime?  @default(now()) @db.Timestamp(6)
  openai_cost              Decimal?   @db.Decimal(10, 6)
  openai_charged           Decimal?   @db.Decimal(10, 6)
  twilio_cost              Decimal?   @db.Decimal(10, 6)
  platform_markup          Decimal?   @db.Decimal(10, 6)
  balance_before           Decimal?   @db.Decimal(10, 2)
  related_call_log_id      String?    @db.Uuid
  call_logs                call_logs? @relation(fields: [related_call_log_id], references: [id], onUpdate: NoAction)
  tenants                  tenants?   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_wallet_transactions_tenant_id")
  @@index([related_call_log_id], map: "idx_wallet_transactions_call_log")
}

model user_tenants {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String?   @db.Uuid
  tenant_id  String?   @db.Uuid
  role       String?   @default("staff") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  tenants    tenants?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, tenant_id])
  @@index([tenant_id], map: "idx_user_tenants_tenant_id")
  @@index([user_id], map: "idx_user_tenants_user_id")
}

model invite_codes {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id          String?   @db.Uuid
  code               String    @unique @db.VarChar(20)
  role               String?   @default("staff") @db.VarChar(50)
  created_by_user_id String?   @db.Uuid
  is_used            Boolean?  @default(false)
  used_by_user_id    String?   @db.Uuid
  used_at            DateTime? @db.Timestamp(6)
  expires_at         DateTime? @db.Timestamp(6)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  created_by         users?    @relation("CreatedInvites", fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  tenants            tenants?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  used_by            users?    @relation("UsedInvites", fields: [used_by_user_id], references: [id], onUpdate: NoAction)

  @@index([tenant_id], map: "idx_invite_codes_tenant_id")
  @@index([code], map: "idx_invite_codes_code")
  @@index([is_used], map: "idx_invite_codes_is_used")
}
